# ==========================================
# TechVerse Backend Environment Configuration
# ==========================================

PORT=5000
MongoDB_url=mongodb+srv://<username>:<password>@cluster.mongodb.net/techverse?retryWrites=true&w=majority

# ==========================================
# Email Configuration (Nodemailer)
# Required to send Club ID cards and confirmation emails
# ==========================================
EMAIL_SERVICE=gmail
EMAIL_USER=techverse@ctuniversity.in
EMAIL_PASS=your_16_character_app_password

# Optional SMTP Settings (if not using standard Gmail/Google Workspace):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false

# ==========================================
# Frontend CORS URLs
# ==========================================
FRONTEND_URL=https://techversectu.vercel.app
